DATABASE_URL="file:/Users/yourname/path/to/platform/lcase-db/sqlite/dev.db"

# S3-compatible CAS adapter integration tests (packages/adapters). Only used
# when set -- unset means those tests are skipped rather than failing. Run
# `docker compose up -d minio` to start a local MinIO matching these
# defaults.
S3_TEST_ENDPOINT="http://localhost:9000"
S3_TEST_BUCKET="artifacts-test"
S3_TEST_ACCESS_KEY_ID="minioadmin"
S3_TEST_SECRET_ACCESS_KEY="minioadmin"
