# SQLite is the default install and the authored schema's provider.
DATABASE_URL="file:/Users/yourname/path/to/platform/lcase-db/sqlite/dev.db"

# The host port the docker-compose Postgres publishes, and the single knob for
# moving it. Docker Compose reads it from this file directly, and the Prisma
# configs and test harness derive their default URLs from it, so setting it here
# moves all three together. Set it if something already holds 5432 -- a native
# Postgres install, most likely.
#
# POSTGRES_HOST_PORT=5434

# Only the Prisma CLI reads this today, for authoring and deploying the Postgres
# migration history. Defaults to the compose service on POSTGRES_HOST_PORT, so
# set it only to name a different server entirely.
#
# POSTGRES_DATABASE_URL="postgresql://lcase:lcase@localhost:5432/lcase"
