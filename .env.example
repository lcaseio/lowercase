# SQLite is the default install and the authored schema's provider.
DATABASE_URL="file:/Users/yourname/path/to/platform/lcase-db/sqlite/dev.db"

# Only the Prisma CLI reads this today, for authoring and deploying the Postgres
# migration history. Defaults to the docker-compose service when unset.
POSTGRES_DATABASE_URL="postgresql://lcase:lcase@localhost:5433/lcase"
