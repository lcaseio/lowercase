{
  "name": "@lcase/runtime",
  "version": "0.1.0-alpha.13",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "lint": "eslint .",
    "clean-dist": "rm -rf ./dist",
    "clean-node-modules": "rm -rf ./node_modules",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@lcase/worker": "workspace:*",
    "@lcase/engine": "workspace:*",
    "@lcase/adapters": "workspace:*",
    "@lcase/events": "workspace:*",
    "@lcase/observability": "workspace:*",
    "@lcase/app-services": "workspace:*",
    "@lcase/replay": "workspace:*",
    "@lcase/limiter": "workspace:*",
    "@lcase/artifacts": "workspace:*",
    "@lcase/db-prisma": "workspace:*",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lcase/ports": "workspace:*",
    "@lcase/types": "workspace:*",
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4",
    "dotenv": "^17.4.2"
  }
}
